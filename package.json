{
  "name": "@smplcty/dev-backend",
  "version": "0.2.0",
  "description": "Local Lambda dev server — reads a routes config, loads .env, serves Lambda handlers over HTTP with API Gateway v2 event translation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "dev-backend": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mabulu-inc/simplicity-dev-backend.git"
  },
  "homepage": "https://github.com/mabulu-inc/simplicity-dev-backend#readme",
  "bugs": {
    "url": "https://github.com/mabulu-inc/simplicity-dev-backend/issues"
  },
  "keywords": [
    "lambda",
    "dev-server",
    "api-gateway",
    "local"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "release": "GITHUB_TOKEN=$(gh auth token) release-it --ci"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.90.0",
    "release-it": "^21.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
